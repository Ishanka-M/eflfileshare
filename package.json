{
  "name": "efl-fileshare",
  "version": "1.0.0",
  "description": "Inbound/Outbound Excel file share on Cloudflare Pages + D1 + R2",
  "scripts": {
    "dev": "wrangler pages dev",
    "db:init:local": "wrangler d1 execute efl-fileshare-db --local --file=schema.sql",
    "db:init:remote": "wrangler d1 execute efl-fileshare-db --remote --file=schema.sql"
  },
  "devDependencies": {
    "wrangler": "^4.161.0"
  },
  "private": true
}
